# XX大學課堂學生請假系統 - 環境變數設定範例
# 複製此檔案為 .env 並填入實際值

# 學校名稱（預設「XX大學」，可依校名自由替換）
SCHOOL_NAME=XX大學

# 伺服器設定
PORT=4321
HOST=0.0.0.0
NODE_ENV=production

# 資料存取路徑（容器內部會掛載至具名 volume）
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads

# 資安金鑰（請使用 openssl rand -hex 32 產生長度至少 64 字元的隨機字串）
SESSION_SECRET=change_this_to_a_random_32_byte_hex_secret_session_key_0123456789abcdef
CSRF_SECRET=change_this_to_a_random_32_byte_hex_secret_csrf_key_0123456789abcdef

# 信任的代理伺服器（Cloudflare Tunnel 運作時設為 true，將嚴格由 CF-Connecting-IP 取得真實 IP）
TRUST_PROXY=true

# Cloudflare Tunnel Token（從 Cloudflare Zero Trust 儀表板取得）
TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2VuMTIzNCIsInQiOiIxMjM0NTY3OC0xMjM0LTEyMzQtMTIzNC0xMjM0NTY3ODkwYWIiLCJzIjoiZXhhbXBsZXNlY3JldCJ9
