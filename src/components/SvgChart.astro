---
interface Props {
  type: 'donut' | 'bar' | 'line';
  data: { label: string; value: number; color?: string }[];
  title?: string;
  height?: number;
}

const { type, data, title, height = 240 } = Astro.props;


const defaultColors = ['#5B7C99', '#7A9E7E', '#B58D3D', '#9E5B5B', '#8C7A9E', '#A3997A', '#6B8E99'];


const total = data.reduce((sum, item) => sum + item.value, 0);
const maxValue = Math.max(...data.map((d) => d.value), 1);


let cumulativeAngle = 0;
const donutSlices = data.map((item, idx) => {
  const percentage = total > 0 ? item.value / total : 0;
  const strokeDasharray = `${percentage * 283} ${283}`;
  const strokeDashoffset = -cumulativeAngle * 283;
  cumulativeAngle += percentage;
  return {
    ...item,
    percentage: Math.round(percentage * 100),
    strokeDasharray,
    strokeDashoffset,
    color: item.color || defaultColors[idx % defaultColors.length]
  };
});
---

<div class="chart-container">
  {title && <h3 class="chart-title">{title}</h3>}

  {type === 'donut' && (
    <div class="donut-chart-wrapper">
      <svg viewBox="0 0 140 140" class="donut-svg" width="160" height="160">
        <circle cx="70" cy="70" r="45" fill="none" stroke="var(--bg-subtle)" stroke-width="18" />
        {donutSlices.map((slice) => (
          <circle
            cx="70"
            cy="70"
            r="45"
            fill="none"
            stroke={slice.color}
            stroke-width="18"
            stroke-dasharray={slice.strokeDasharray}
            stroke-dashoffset={slice.strokeDashoffset}
            transform="rotate(-90 70 70)"
            class="donut-segment"
          />
        ))}
        <text x="70" y="67" text-anchor="middle" font-size="16" font-weight="600" fill="var(--text-main)">
          {total}
        </text>
        <text x="70" y="82" text-anchor="middle" font-size="10" fill="var(--text-muted)">
          總件數
        </text>
      </svg>
      <div class="legend-list">
        {donutSlices.map((slice) => (
          <div class="legend-item">
            <span class="legend-color" style={`background-color: ${slice.color};`} />
            <span class="legend-label">{slice.label}</span>
            <span class="legend-value">{slice.value} ({slice.percentage}%)</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {type === 'bar' && (
    <div class="bar-chart-wrapper" style={`min-height: ${height}px;`}>
      {data.length === 0 ? (
        <div class="empty-chart">暫無統計資料</div>
      ) : (
        <div class="bar-list">
          {data.map((item, idx) => {
            const barWidth = Math.max(Math.round((item.value / maxValue) * 100), 2);
            const color = item.color || defaultColors[idx % defaultColors.length];
            return (
              <div class="bar-item">
                <div class="bar-header">
                  <span class="bar-label">{item.label}</span>
                  <span class="bar-value">{item.value} 件</span>
                </div>
                <div class="bar-track">
                  <div
                    class="bar-fill"
                    style={`width: ${barWidth}%; background-color: ${color};`}
                  />
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  )}

  {type === 'line' && (
    <div class="line-chart-wrapper">
      {data.length === 0 ? (
        <div class="empty-chart">暫無統計資料</div>
      ) : (
        <svg viewBox="0 0 500 200" class="line-svg" preserveAspectRatio="none">
          
          <line x1="40" y1="30" x2="480" y2="30" stroke="var(--border-color)" stroke-dasharray="3 3" />
          <line x1="40" y1="90" x2="480" y2="90" stroke="var(--border-color)" stroke-dasharray="3 3" />
          <line x1="40" y1="150" x2="480" y2="150" stroke="var(--border-color)" stroke-dasharray="3 3" />

          
          {(() => {
            const chartLeft = 50;
            const chartRight = 470;
            const chartTop = 30;
            const chartBottom = 150;
            const points = data.map((d, i) => {
              const x = chartLeft + (i / Math.max(data.length - 1, 1)) * (chartRight - chartLeft);
              const y = chartBottom - (d.value / maxValue) * (chartBottom - chartTop);
              return { x, y, label: d.label, value: d.value };
            });
            const polylinePoints = points.map((p) => `${p.x},${p.y}`).join(' ');

            return (
              <g>
                <polyline
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="3"
                  points={polylinePoints}
                />
                {points.map((p) => (
                  <g>
                    <circle cx={p.x} cy={p.y} r="5" fill="var(--bg-surface)" stroke="var(--accent)" stroke-width="2.5" />
                    <text x={p.x} y={p.y - 10} text-anchor="middle" font-size="11" fill="var(--text-main)" font-weight="500">
                      {p.value}
                    </text>
                    <text x={p.x} y="175" text-anchor="middle" font-size="11" fill="var(--text-muted)">
                      {p.label}
                    </text>
                  </g>
                ))}
              </g>
            );
          })()}
        </svg>
      )}
    </div>
  )}
</div>

<style>
  .chart-container {
    width: 100%;
  }
  .chart-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }
  .donut-chart-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .donut-chart-wrapper {
      flex-direction: row;
      justify-content: space-around;
    }
  }
  .donut-svg {
    transform: rotate(0deg);
  }
  .legend-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
  }
  .legend-color {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .legend-label {
    color: var(--text-muted);
  }
  .legend-value {
    font-weight: 500;
    color: var(--text-main);
    margin-left: auto;
  }

  .bar-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .bar-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    margin-bottom: 0.35rem;
  }
  .bar-label {
    font-weight: 500;
  }
  .bar-value {
    color: var(--text-muted);
  }
  .bar-track {
    width: 100%;
    height: 10px;
    background-color: var(--bg-subtle);
    border-radius: 5px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 5px;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .line-svg {
    width: 100%;
    height: 200px;
  }

  .empty-chart {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 150px;
    color: var(--text-light);
    font-size: 0.9rem;
  }
</style>
