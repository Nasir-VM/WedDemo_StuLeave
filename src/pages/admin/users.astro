---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { listUsers } from '../../db/queries/users';
import { listDepartments } from '../../db/queries/courses';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}

const url = Astro.url;
const searchParams = url.searchParams;

const page = parseInt(searchParams.get('page') || '1', 10);
const pageSize = 15;
const offset = (page - 1) * pageSize;

const role = searchParams.get('role') || '';
const departmentId = searchParams.get('departmentId') || '';
const search = searchParams.get('search') || '';

const { users, total } = listUsers({
  role: role || undefined,
  departmentId: departmentId || undefined,
  search: search || undefined,
  limit: pageSize,
  offset
});

const departments = listDepartments();
const totalPages = Math.ceil(total / pageSize);
const csrfToken = Astro.locals.csrfToken;
---

<DashboardLayout title="使用者帳號管理">
  <div class="users-page">
    <div class="page-header">
      <div>
        <h1 class="page-title">使用者帳號管理</h1>
        <p class="page-sub">管理全校學生、教師與管理人員帳號資訊</p>
      </div>
      <button type="button" id="openCreateModalBtn" class="btn btn-primary">
        + 新增使用者
      </button>
    </div>

    
    <div class="card filter-card">
      <form method="GET" class="filter-form">
        <div class="filter-grid">
          <div class="filter-group">
            <label class="filter-label" for="roleSelect">身分角色</label>
            <select id="roleSelect" name="role" class="form-control form-control-sm">
              <option value="">全部身分</option>
              <option value="student" selected={role === 'student'}>學生</option>
              <option value="teacher" selected={role === 'teacher'}>教師</option>
              <option value="admin" selected={role === 'admin'}>管理員</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="deptSelect">所屬系所</label>
            <select id="deptSelect" name="departmentId" class="form-control form-control-sm">
              <option value="">全部系所</option>
              {departments.map((d) => (
                <option value={d.id} selected={departmentId === d.id}>
                  {d.name}
                </option>
              ))}
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="searchInput">搜尋</label>
            <input
              type="text"
              id="searchInput"
              name="search"
              class="form-control form-control-sm"
              placeholder="學號、姓名或信箱..."
              value={search}
            />
          </div>
        </div>

        <div class="filter-actions">
          <button type="submit" class="btn btn-primary btn-sm">套用篩選</button>
          <a href="/admin/users" class="btn btn-secondary btn-sm">重設</a>
        </div>
      </form>
    </div>

    
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>學號 / 教工號</th>
            <th>姓名</th>
            <th>身分</th>
            <th>系所</th>
            <th>電子信箱</th>
            <th>密碼狀態</th>
            <th>狀態</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          {users.map((u) => (
            <tr>
              <td><code>{u.id}</code></td>
              <td><strong>{u.name}</strong></td>
              <td>
                <span class={`role-tag role-${u.role}`}>
                  {u.role === 'student' ? '學生' : u.role === 'teacher' ? '教師' : '管理員'}
                </span>
              </td>
              <td>{u.department_name || '—'}</td>
              <td>{u.email}</td>
              <td>
                {u.must_change_password ? (
                  <span class="badge badge-pending">需強制改密碼</span>
                ) : (
                  <span class="text-light">正常</span>
                )}
              </td>
              <td>
                {u.is_active ? (
                  <span class="badge badge-approved">啟用中</span>
                ) : (
                  <span class="badge badge-rejected">已停用</span>
                )}
              </td>
              <td>
                {u.id !== user.id && (
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm toggle-active-btn"
                    data-id={u.id}
                    data-active={u.is_active ? '1' : '0'}
                  >
                    {u.is_active ? '停用' : '啟用'}
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <Pagination currentPage={page} totalPages={totalPages} baseUrl={url.pathname + url.search} />

    
    <div id="createModal" class="modal-overlay" style="display: none;">
      <div class="modal-content card">
        <div class="modal-header">
          <h2 class="modal-title">新增使用者帳號</h2>
          <button type="button" id="closeModalBtn" class="close-btn" aria-label="關閉">✕</button>
        </div>

        <div id="modalAlert" class="alert alert-error" style="display: none;" role="alert"></div>

        <form id="createUserForm" novalidate>
          <input type="hidden" name="csrf_token" value={csrfToken} />

          <div class="form-group">
            <label class="form-label" for="newUserId">
              學號 / 教職員號 <span class="required">*</span>
            </label>
            <input
              type="text"
              id="newUserId"
              name="id"
              class="form-control"
              placeholder="例如：S112004 或 T003"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="newUserName">
              姓名 <span class="required">*</span>
            </label>
            <input
              type="text"
              id="newUserName"
              name="name"
              class="form-control"
              placeholder="例如：王小明"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="newUserEmail">
              電子信箱 <span class="required">*</span>
            </label>
            <input
              type="email"
              id="newUserEmail"
              name="email"
              class="form-control"
              placeholder="例如：user@example.edu.tw"
              required
            />
          </div>

          <div class="grid grid-cols-2">
            <div class="form-group">
              <label class="form-label" for="newUserRole">
                角色 <span class="required">*</span>
              </label>
              <select id="newUserRole" name="role" class="form-control" required>
                <option value="student">學生</option>
                <option value="teacher">教師</option>
                <option value="admin">管理員</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="newUserDept">所屬系所</label>
              <select id="newUserDept" name="departmentId" class="form-control">
                <option value="">未指定</option>
                {departments.map((d) => (
                  <option value={d.id}>{d.name}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="newUserPassword">
              預設初始密碼 <span class="required">*</span>
            </label>
            <input
              type="text"
              id="newUserPassword"
              name="initialPassword"
              class="form-control"
              value="InitPass123!"
              required
            />
            <div class="form-hint">長度至少 8 碼，使用者首次登入時將被強制修改此密碼。</div>
          </div>

          <div class="modal-footer">
            <button type="button" id="cancelModalBtn" class="btn btn-secondary">取消</button>
            <button type="submit" id="saveUserBtn" class="btn btn-primary">確認建立</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('createModal');
    const openBtn = document.getElementById('openCreateModalBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const cancelBtn = document.getElementById('cancelModalBtn');
    const form = document.getElementById('createUserForm');
    const modalAlert = document.getElementById('modalAlert');
    const saveBtn = document.getElementById('saveUserBtn');

    openBtn?.addEventListener('click', () => {
      modal.style.display = 'flex';
      modalAlert.style.display = 'none';
    });

    const closeModal = () => {
      modal.style.display = 'none';
    };

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      modalAlert.style.display = 'none';

      const id = document.getElementById('newUserId').value.trim();
      const name = document.getElementById('newUserName').value.trim();
      const email = document.getElementById('newUserEmail').value.trim();
      const role = document.getElementById('newUserRole').value;
      const departmentId = document.getElementById('newUserDept').value || null;
      const initialPassword = document.getElementById('newUserPassword').value;
      const csrfToken = form.querySelector('input[name="csrf_token"]').value;

      if (!id || !name || !email || !initialPassword) {
        modalAlert.textContent = '請填寫所有必填欄位';
        modalAlert.style.display = 'block';
        return;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = '建立中...';

      try {
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken
          },
          body: JSON.stringify({
            action: 'create',
            id,
            name,
            email,
            role,
            departmentId,
            initialPassword
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert('使用者建立成功！');
          window.location.reload();
        } else {
          modalAlert.textContent = data.error || '建立失敗';
          modalAlert.style.display = 'block';
          saveBtn.disabled = false;
          saveBtn.textContent = '確認建立';
        }
      } catch {
        modalAlert.textContent = '網路通訊異常';
        modalAlert.style.display = 'block';
        saveBtn.disabled = false;
        saveBtn.textContent = '確認建立';
      }
    });

    
    document.querySelectorAll('.toggle-active-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-id');
        const currentActive = btn.getAttribute('data-active') === '1';
        const targetActive = !currentActive;

        if (!confirm(`確定要${targetActive ? '啟用' : '停用'} 使用者 ${userId} 嗎？`)) return;

        const csrfToken = document.querySelector('.app-layout')?.getAttribute('data-csrf') || '';

        try {
          const res = await fetch('/api/admin/users', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-csrf-token': csrfToken
            },
            body: JSON.stringify({
              action: 'toggleActive',
              userId,
              isActive: targetActive
            })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error || '狀態更新失敗');
          }
        } catch {
          alert('網路異常，請稍後重試');
        }
      });
    });
  </script>
</DashboardLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .page-title {
    font-size: 1.35rem;
    font-weight: 600;
  }
  .page-sub {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .filter-card {
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    background-color: var(--bg-surface);
  }
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.85rem;
  }
  @media (min-width: 640px) {
    .filter-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .filter-label {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
    font-weight: 500;
  }
  .form-control-sm {
    min-height: 36px;
    padding: 0.35rem 0.65rem;
    font-size: 0.88rem;
  }
  .filter-actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
    justify-content: flex-end;
  }
  .role-tag {
    font-size: 0.8rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }
  .role-student { background-color: var(--bg-subtle); color: var(--text-muted); }
  .role-teacher { background-color: var(--accent-light); color: var(--accent); }
  .role-admin { background-color: var(--status-pending-bg); color: var(--status-pending-text); }

  
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 1rem;
  }
  .modal-content {
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    background-color: var(--bg-surface);
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .modal-title {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .close-btn {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--text-muted);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }
  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .alert-error {
    background-color: var(--status-rejected-bg);
    color: var(--status-rejected-text);
  }
</style>
