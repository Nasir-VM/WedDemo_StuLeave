---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from '../config/env';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const isFirstLogin = user.must_change_password === 1;
const csrfToken = Astro.locals.csrfToken;
const schoolName = env.SCHOOL_NAME;
---

<BaseLayout title="修改密碼">
  <div class="pwd-page">
    <div class="pwd-container">
      <div class="card pwd-card">
        <h1 class="page-title">{isFirstLogin ? '首次登入安全設定' : '修改密碼'}</h1>
        
        {isFirstLogin ? (
          <div class="alert alert-warning" role="alert">
            <strong>提醒：</strong>依據校園資安規範，首次登入系統必須修改預設密碼方可啟用各項功能。
          </div>
        ) : (
          <p class="page-desc">為確保帳號安全，請設定包含大小寫英文字母、數字與特殊符號之強密碼。</p>
        )}

        <div id="errorAlert" class="alert alert-error" style="display: none;" role="alert"></div>
        <div id="successAlert" class="alert alert-success" style="display: none;" role="alert"></div>

        <form id="pwdForm" novalidate>
          <input type="hidden" name="csrf_token" value={csrfToken} />

          {!isFirstLogin && (
            <div class="form-group">
              <label for="currentPassword" class="form-label">
                目前密碼 <span class="required">*</span>
              </label>
              <input
                type="password"
                id="currentPassword"
                name="currentPassword"
                class="form-control"
                required
                autocomplete="current-password"
              />
            </div>
          )}

          <div class="form-group">
            <label for="newPassword" class="form-label">
              新密碼 <span class="required">*</span>
            </label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              class="form-control"
              required
              autocomplete="new-password"
            />
            <div class="form-hint">需長度至少 8 碼，並包含大寫字母、小寫字母、數字及特殊符號。</div>
          </div>

          <div class="form-group">
            <label for="confirmPassword" class="form-label">
              確認新密碼 <span class="required">*</span>
            </label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="form-control"
              required
              autocomplete="new-password"
            />
          </div>

          <button type="submit" id="submitBtn" class="btn btn-primary btn-block">
            確認變更密碼
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('pwdForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorAlert = document.getElementById('errorAlert');
    const successAlert = document.getElementById('successAlert');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.style.display = 'none';
      successAlert.style.display = 'none';

      const currentPassword = document.getElementById('currentPassword')?.value || '';
      const newPassword = document.getElementById('newPassword')?.value;
      const confirmPassword = document.getElementById('confirmPassword')?.value;
      const csrfToken = form.querySelector('input[name="csrf_token"]').value;

      if (!newPassword || !confirmPassword) {
        errorAlert.textContent = '請填寫所有必填欄位';
        errorAlert.style.display = 'block';
        return;
      }

      if (newPassword !== confirmPassword) {
        errorAlert.textContent = '兩次輸入的新密碼不一致';
        errorAlert.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '更新中...';

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken
          },
          body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          errorAlert.textContent = data.error || '密碼更新失敗';
          errorAlert.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = '確認變更密碼';
          return;
        }

        successAlert.textContent = '密碼變更成功！正在前往首頁...';
        successAlert.style.display = 'block';

        setTimeout(() => {
          window.location.href = data.data.redirect || '/';
        }, 1200);
      } catch (err) {
        errorAlert.textContent = '網路異常，請稍後再試';
        errorAlert.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '確認變更密碼';
      }
    });
  </script>
</BaseLayout>

<style>
  .pwd-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem;
    background-color: var(--bg-primary);
  }

  .pwd-container {
    width: 100%;
    max-width: 480px;
  }

  .page-title {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .btn-block {
    width: 100%;
    margin-top: 1rem;
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .alert-warning {
    background-color: var(--status-pending-bg);
    color: var(--status-pending-text);
    border: 1px solid rgba(181, 141, 61, 0.2);
  }

  .alert-error {
    background-color: var(--status-rejected-bg);
    color: var(--status-rejected-text);
  }

  .alert-success {
    background-color: var(--accent-green-light);
    color: var(--accent-green);
  }
</style>
